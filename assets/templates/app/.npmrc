# Retry tuning only. Do NOT pin a registry here: an internal mirror is usually unreachable from
# Databricks cloud and the "Installing packages" phase hangs. Set npm_config_registry per context.
# Do NOT add omit=optional: it drops esbuild/rollup native binaries.
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
