# Local development only. Copy to server/.env and paste your own PAT. Never commit server/.env.
APP_ENV=local
DATABRICKS_HOST=https://<dev-host>
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/<warehouse-id>
DATABRICKS_TOKEN=<paste-your-personal-access-token>
DATABRICKS_CATALOG={{DEFAULT_CATALOG}}
DATABRICKS_SCHEMA={{DEFAULT_SCHEMA}}
DEV_USER_EMAIL=<you@example.com>
# Optional
# SQL_TIMING=true
# WARM_SESSION_CACHE=true
# FORCE_WAREHOUSE_STATE=STARTING
